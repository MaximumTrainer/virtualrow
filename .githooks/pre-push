#!/bin/sh
#
# Pre-push verification — the same gate CI runs (.github/workflows/npm-preflight.yml),
# so a red branch is caught here rather than three minutes into a PR.
#
#   lint → build → full unit suite → coverage thresholds
#
# Skip with SKIP_HOOKS=1 git push, or git push --no-verify.
#
set -e

if [ "$SKIP_HOOKS" = "1" ]; then
  echo "pre-push: skipped (SKIP_HOOKS=1)"
  exit 0
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# git feeds us "<local ref> <local sha> <remote ref> <remote sha>" per ref. A
# deletion carries the all-zero local sha and ships no code, so verifying one
# is three minutes spent to prove nothing: `git push --delete` would otherwise
# run the whole suite before removing a merged branch.
saw_ref=0
pushing_code=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  saw_ref=1
  case "$local_sha" in
    '' | *[!0]*) pushing_code=1 ;;
  esac
done

# No refs on stdin means we are not being driven by git (a manual run, say):
# verify rather than assume, so the gate never opens by accident.
if [ "$saw_ref" = "1" ] && [ "$pushing_code" = "0" ]; then
  echo "pre-push: deletions only — nothing to verify"
  exit 0
fi

echo ""
echo "── lint"
npm run lint

echo ""
echo "── build"
npm run build

echo ""
echo "── unit tests + coverage gate"
# Thresholds live in vitest.config.ts; vitest exits non-zero when one is missed.
npm run coverage

echo ""
echo "pre-push: green"
